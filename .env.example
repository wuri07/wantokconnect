# ---------- Frontend (public, baked into the build by Vite) ----------
# Supabase dashboard > Project Settings > API > Project URL and "anon public" key.
# The anon key is safe in the browser ONLY because Row Level Security is enabled (see supabase/migrations/001_schema.sql).
VITE_SUPABASE_URL=https://rgoxjeqjoomgrqiomduv.supabase.co
VITE_SUPABASE_ANON_KEY=paste-your-anon-public-key-here

# ---------- Server only (never prefix with VITE_, never commit real values) ----------
# Supabase dashboard > Connect > Transaction pooler (port 6543). Use this for the running app: it pools connections.
# Replace [PASSWORD] with your database password and [REGION] with the region shown in the dashboard.
DATABASE_URL=postgresql://postgres.rgoxjeqjoomgrqiomduv:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Session pooler or direct connection (port 5432). Use this only for running migrations from your computer.
DIRECT_URL=postgresql://postgres.rgoxjeqjoomgrqiomduv:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Long random string. Protects POST /api/admin/storefront/:id (storefront verification).
ADMIN_API_TOKEN=change-me-to-a-long-random-string
PORT=3000
